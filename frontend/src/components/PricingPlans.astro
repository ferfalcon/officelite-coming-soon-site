---
import Countdown from './Countdown.astro';
import PricingCard from './PricingCard.astro';
import { PLANS } from '../data/product';
import { buildSignUpUrl } from '../lib/plan-context';

const genericSignUpUrl = buildSignUpUrl();
---

<section class="pricing" aria-label="Pricing plans">
  <div class="pricing__surface" aria-hidden="true"></div>

  <div class="pricing__content container">
    <div class="pricing__cards">
      {
        PLANS.map((plan) => (
          <PricingCard plan={plan} href={buildSignUpUrl(plan.key)} />
        ))
      }
    </div>

    <div class="pricing__launch">
      <Countdown tone="dark" class="pricing__countdown" />
      <a class="pricing__launch-cta" href={genericSignUpUrl}>Get Started</a>
    </div>
  </div>
</section>

<style>
  .pricing {
    position: relative;
    margin-block-start: var(--space-1000);
    overflow: clip;
  }

  .pricing__surface {
    position: absolute;
    z-index: 0;
    inset-inline: 0;
    inset-block-start: 31.125rem;
    inset-block-end: 0;
    background-color: var(--color-neutral-900);
    background-image: url('../assets/home/bg-pattern-footer.svg');
    background-repeat: no-repeat;
    background-position: center 9rem;
    background-size: 75rem;
    pointer-events: none;
  }

  .pricing__content {
    position: relative;
    z-index: 1;
    padding-block-end: 7rem;
  }

  .pricing__cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-300);
  }

  .pricing__launch {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-600);
    margin-block-start: var(--space-1000);
  }

  .pricing__launch-cta {
    display: inline-flex;
    min-height: 3.125rem;
    align-items: center;
    justify-content: center;
    padding: var(--space-150) var(--space-500);
    border-radius: var(--radius-full);
    background: var(--color-blue-500);
    box-shadow: 0 25px 12.5px rgb(63 91 194 / 25%);
    color: var(--color-neutral-0);
    font-size: var(--font-label-size);
    font-weight: 700;
    line-height: var(--line-height-label);
    text-align: center;
    text-decoration: none;
  }

  .pricing__launch-cta:hover {
    background: var(--color-blue-300);
  }

  :global(.pricing__countdown .countdown__launch) {
    text-align: center;
  }

  @media (min-width: 48rem) {
    .pricing {
      margin-block-start: 7rem;
    }

    .pricing__surface {
      background-position: center 12rem;
      background-size: 90.875rem;
    }

    .pricing__content {
      padding-block-end: 8.125rem;
    }

    .pricing__cards {
      gap: var(--space-250);
    }

    .pricing__launch {
      margin-block-start: var(--space-1200);
    }
  }

  @media (min-width: 74.375rem) {
    .pricing {
      margin-block-start: var(--space-1800);
    }

    .pricing__surface {
      inset-block-start: 15.875rem;
      background-position: calc(50% - 33rem) 50%;
      background-size: 127.25rem;
    }

    .pricing__content {
      padding-block-end: 7.5625rem;
    }

    .pricing__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-400);
    }

    .pricing__launch {
      flex-direction: row;
      justify-content: space-between;
      gap: var(--space-400);
      margin-block-start: var(--space-1000);
    }

    :global(.pricing__countdown .countdown__launch) {
      margin-block-end: var(--space-150);
      text-align: start;
    }
  }
</style>
